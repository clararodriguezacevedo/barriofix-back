# ==============================================================================
# BarrioFix Backend — variables de entorno
# ==============================================================================
#
# UN solo archivo, DOS destinos:
#
#   1) Local: copialo a `.env` y usalo con scripts/dev-local.sh.
#      cp .env.example .env
#
#   2) AWS: copialo a `backend.env`, completá los valores reales, y subilo al
#      bucket de artefactos. Todas las instancias del ASG lo bajan al arrancar
#      y systemd lo lee via EnvironmentFile= (ver docs/DEPLOY-AWS.md, Fase 4b).
#      aws s3 cp backend.env s3://barriofix-artifacts-clara/backend.env
#
# `.env` y `backend.env` están en .gitignore y NO se commitean. Este archivo
# (`.env.example`) SÍ, porque documenta qué necesita el proyecto sin filtrar
# valores reales.
#
# ⚠️ En EC2 no hay Environment= sueltos ni valores horneados en la AMI. TODO
#    vive en el `backend.env` de S3. Cambiar una variable = re-subir el archivo
#    y reciclar las instancias.
#
# ==============================================================================


# ------------------------------------------------------------------------------
# SECCIÓN 1 — Las que el backend LEE de verdad
# ------------------------------------------------------------------------------
# Son las únicas tres que el código consulta en runtime. Todo lo demás en este
# archivo es documentación de apoyo.

# Región de AWS donde vive todo el proyecto.
# Cómo reemplazarlo: es la región que ves arriba a la derecha en la consola de AWS.
# Tiene que ser la MISMA que la del bucket de media, o boto3 falla con un redirect.
# Leído en: app/routers/media.py
AWS_REGION=us-east-1

# Bucket de S3 con las fotos que sirve GET /api/media.
# Cómo reemplazarlo: S3 → Buckets → copiá el nombre exacto (solo el nombre,
# sin "s3://" y sin la región).
# ⚠️ NO uses acá el bucket de artefactos de deploy: GET /api/media lista el bucket
#    ENTERO, así que el app.tar.gz aparecería como si fuera una foto.
# Leído en: app/routers/media.py
MEDIA_BUCKET=barriofix-media-clara

# Orígenes que pueden llamar a la API desde un browser, separados por coma.
#
# El default del código es "*" (cualquier origen), que es lo que está desplegado
# hoy y funciona bien para el lab. Setear un origen explícito es un endurecimiento
# OPCIONAL — no arregla ningún bug.
#
# Cómo reemplazarlo: S3 → tu bucket de frontend → Properties → Static website
# hosting → copiá el "Bucket website endpoint" EXACTO.
# ⚠️ Tiene que coincidir carácter por carácter con lo que muestra la barra del
#    browser. Estas dos formas son ambas válidas en AWS pero son orígenes
#    DISTINTOS para CORS:
#       http://mi-bucket.s3-website-us-east-1.amazonaws.com   (guión)
#       http://mi-bucket.s3-website.us-east-1.amazonaws.com   (punto)
# ⚠️ Sin barra final, y con el http:// incluido.
#
# Para desarrollo local agregá tu dev server separado por coma, por ejemplo:
#   CORS_ORIGINS=http://barriofix-frontend-clara.s3-website-us-east-1.amazonaws.com,http://localhost:5173
#
# Leído en: app/main.py
CORS_ORIGINS=http://barriofix-frontend-clara.s3-website-us-east-1.amazonaws.com


# Conexión a la base PostgreSQL en RDS.
#
# ⚠️ LLEVA LA CONTRASEÑA. Este repo es PÚBLICO en GitHub: nunca la pongas acá
#    ni en ningún archivo versionado. El `.env` real está en .gitignore.
#
# Formato:
#   postgresql://USUARIO:CONTRASEÑA@HOST:5432/BASE?sslmode=require
#
# Cómo obtener el host: RDS → Databases → tu instancia → "Endpoint".
# Si la contraseña tiene caracteres raros (@ : / ?) hay que url-encodearlos.
#
# Sobre sslmode:
#   require      → cifra la conexión sin validar el certificado. Es lo que usa
#                  la app, porque verify-full necesita el bundle de CAs de AWS
#                  (global-bundle.pem) dentro de la instancia, y las instancias
#                  no tienen internet para bajarlo en el arranque.
#   verify-full  → si lo querés, hay que hornear el .pem en la AMI y agregar
#                  &sslrootcert=/opt/barriofix/global-bundle.pem
#
# Leído en: app/db.py
DATABASE_URL=postgresql://barriofix_admin:TU_PASSWORD@barriofix-db.cqjc5npa5wk3.us-east-1.rds.amazonaws.com:5432/barriofix?sslmode=require

# Clave con la que se firman los JWT.
#
# ⚠️ TIENE QUE SER LA MISMA EN LAS DOS INSTANCIAS DEL ASG. Si cada una usa una
#    distinta, el token emitido por una es rechazado por la otra y los usuarios
#    ven cierres de sesión intermitentes imposibles de diagnosticar. Por eso el
#    código explota si falta, en vez de generar una al azar.
#
# Generá una así:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Leído en: app/security.py
JWT_SECRET=generá-una-y-pegala-acá

# Minutos de validez del token. 720 = 12 horas.
# Leído en: app/security.py
JWT_EXPIRE_MINUTES=720


# ------------------------------------------------------------------------------
# SECCIÓN 2 — Nombres de infraestructura (el backend NO los lee)
# ------------------------------------------------------------------------------
# Van comentados a propósito: setearlos no cambia nada en la app. Están acá para
# que todos los nombres de AWS del proyecto vivan en un solo lugar y no haya que
# ir a buscarlos a la consola cada vez.

# Bucket donde se sube el app.tar.gz que las instancias bajan al arrancar.
# Lo consume: el User Data de la Launch Template (docs/DEPLOY-AWS.md, Fase 6).
# Cómo reemplazarlo: tiene que ser un bucket DISTINTO al de MEDIA_BUCKET.
#ARTIFACTS_BUCKET=barriofix-artifacts-clara

# DNS del Application Load Balancer: la URL base de la API.
# Lo consume: el frontend (ver docs/API-FRONTEND.md), no el backend.
# Cómo reemplazarlo: EC2 → Load Balancers → columna "DNS name".
# ⚠️ Hay un segundo ALB (barriofix-alb-1097909841) que está MUERTO y devuelve 503
#    en todo. El vivo es el que termina en 793636717. Verificá con:
#       curl http://<dns>/health   →  {"status":"ok"}
#ALB_DNS=barriofix-alb-793636717.us-east-1.elb.amazonaws.com

# Bucket donde logrotate sube los logs de la aplicacion cada 15 minutos.
# Lo consume: /usr/local/bin/barriofix-subir-logs.sh dentro de la AMI, no el backend.
# Tiene que ser un tercer bucket, distinto de MEDIA_BUCKET y ARTIFACTS_BUCKET.
#LOGS_BUCKET=barriofix-logs-clara

# Website endpoint del bucket de frontend. Mismo valor que CORS_ORIGINS.
# Lo consume: nadie automáticamente — está acá como referencia cruzada.
#FRONTEND_URL=http://barriofix-frontend-clara.s3-website-us-east-1.amazonaws.com

# Puerto donde escucha Uvicorn.
# NO es configurable por env var: está fijo en tres lugares que tienen que
# coincidir — el ExecStart del systemd unit, el puerto del Target Group, y el
# inbound del security group del backend. Si lo cambiás, cambialo en los tres.
#APP_PORT=8080

# Instance profile que le da permisos de S3 a las instancias.
# En AWS Academy Learner Lab no se pueden crear roles: siempre es este.
#IAM_INSTANCE_PROFILE=LabInstanceProfile
